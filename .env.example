# Supabase project (Project Settings → API). Use the publishable key, never the secret key.
EXPO_PUBLIC_SUPABASE_URL=https://<project-id>.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...

# Length of the emailed one-time code; must match Supabase → Authentication → Email → Email OTP Length.
EXPO_PUBLIC_OTP_LENGTH=8
